# Local API (uvicorn). Copy to backend/.env and replace placeholders.
# Production must use PostgreSQL, AUTO_CREATE_SCHEMA=false, and explicit CORS origins.

DATABASE_URL=sqlite+aiosqlite:///./data/circuitbreaker.db
DATABASE_SSL=false
PORT=8000

API_KEY_READ=replace-with-read-key
API_KEY_WRITE=replace-with-write-key
API_KEY_OPS=
TENANT_KEYS_JSON=

DEMO_MODE=true
DEMO_RECOVERY_WINDOW_SECONDS=30
RECOVERY_WINDOW_SECONDS=180
MAX_RECOVERY_ATTEMPTS=3
MAX_CART_HOLD_SECONDS=180

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_URL=
LLM_PROVIDER=simulated
AUTO_CREATE_SCHEMA=true

REDIS_URL=
WORKER_ENABLED=false

CIRCUIT_FAILURE_RATE_THRESHOLD=0.30
CIRCUIT_MIN_SAMPLES=8
CIRCUIT_WINDOW_SECONDS=60
CIRCUIT_COOLDOWN_SECONDS=60
CIRCUIT_ANOMALY_ZSCORE=2.0
CIRCUIT_ANOMALY_MIN_SAMPLES=3

RATE_LIMIT_CHECKOUT_PER_MINUTE=60
RATE_LIMIT_RECOVERY_PER_MINUTE=30
ALERT_MANUAL_REVIEW_DEPTH=25
ALERT_CIRCUIT_OPEN_SECONDS=300
ALERT_ERROR_RATE_THRESHOLD=0.50

POLICY_RETRY_MIN=2
POLICY_RETRY_MAX=5
POLICY_AMOUNT_MIN=5000
POLICY_AMOUNT_MAX=50000
POLICY_COOLDOWN_MIN=10
POLICY_COOLDOWN_MAX=120

LOG_LEVEL=INFO
DEFAULT_TENANT_ID=TENANT_DEFAULT

# Reserved. Authentication uses API_KEY_READ / API_KEY_WRITE / TENANT_KEYS_JSON.
SECRET_KEY=
