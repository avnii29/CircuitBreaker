# Local docker compose. Copy to .env and replace placeholders.
# Do not commit .env.

POSTGRES_USER=circuitbreaker
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=circuitbreaker

API_KEY_READ=replace-with-read-key
API_KEY_WRITE=replace-with-write-key
API_KEY_OPS=
TENANT_KEYS_JSON=

DEMO_MODE=true
DEMO_RECOVERY_WINDOW_SECONDS=30
RECOVERY_WINDOW_SECONDS=180
MAX_RECOVERY_ATTEMPTS=3
MAX_CART_HOLD_SECONDS=180

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173
WEBHOOK_URL=

CIRCUIT_FAILURE_RATE_THRESHOLD=0.30
CIRCUIT_MIN_SAMPLES=8
CIRCUIT_WINDOW_SECONDS=60
CIRCUIT_COOLDOWN_SECONDS=60
